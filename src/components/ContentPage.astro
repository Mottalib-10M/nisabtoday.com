---
/** A topic page in one language: H1, one-line answer, the calculator at once, the folded answer, the body, FAQ, sources. */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import Body from './Body.astro';
import { route, hasRoute, type Locale } from '../i18n/routes';
import { label, GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { guideById } from '../lib/pages';
import { helpers, sourceOf } from '../lib/helpers';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { GuideDef } from '../lib/page-types';
interface Props { page: GuideDef; lang: Locale }
const { page: def, lang } = Astro.props;
const page = def[lang]!;
const ui = t(lang);
const path = route(def.id, lang);
const group = GROUPS.find((g) => g.id === def.group)!;
const jsonLd = [webApplicationSchema({ name: page.h1, description: page.description, path, lang }), articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const card = (id: string) => guideById(id)?.[lang]?.card ?? '';
const related = def.related.filter((id) => hasRoute(id, lang)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: card(id) }));
const sources = def.sources.map((k) => sourceOf(k, lang));
const line = lang === 'ar' ? 'سعر الذهب والفضة لليوم · حساب لا فتوى' : 'gold and silver at today’s price · a calculation, not a fatwa';
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: group.label[lang] }, { label: page.nav }]} pageId={def.id}>
  <article>
    <header class="mb-4">
      <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{page.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{page.intro}</p>
    </header>
    <div data-outil data-chrome class="mb-4"><Tool kind={def.tool} arg={def.toolArg} idPrefix={`p${def.order}`} lang={lang} /></div>
    <p class="mb-6 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method', lang)}</a> · {line}</p>
    <Clamp text={page.resume} lang={lang} id={`clamp-${def.id}`} class="mb-8" />
    <Body html={page.body(helpers(lang))} path={path} lang={lang} />
  </article>
</PageLayout>
