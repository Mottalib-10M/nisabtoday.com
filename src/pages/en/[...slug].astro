---
/** Every topic page in English (src/content/guides). */
import ContentPage from '../../components/ContentPage.astro';
import { guidesIn } from '../../lib/pages';
export function getStaticPaths() {
  return guidesIn('en').map((page) => ({ params: { slug: page.en.slug }, props: { def: page } }));
}
const { def } = Astro.props;
---
<ContentPage page={def} lang="en" />
