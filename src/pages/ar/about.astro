---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, AUTHOR_DESC, CONTACT_EMAIL } from '../../data/site-config';
import { helpers } from '../../lib/helpers';
import { profilePageSchema, breadcrumbSchema } from '../../lib/seo';
const lang = 'ar';
const h = helpers(lang);
const path = route('about', lang);
const title = 'ناشر حاسبة الزكاة 2026: من يقف وراء هذا الموقع المستقل';
const description = 'تنشر حاسبة الزكاة شركة Radif Partners المستقلة ومقرها فرنسا. ليست جمعية ولا جهة دينية: لا تبرع ولا حساب ولا بريد، والمصادر مذكورة في كل صفحة من صفحات الموقع.';
---
<PageLayout title={title} description={description} lang={lang} jsonLd={[profilePageSchema({ path, lang }), breadcrumbSchema([{ name: 'الرئيسية', path: route('home', lang) }, { name: 'من نحن', path }])]} breadcrumbs={[{ label: 'من نحن' }]}>
  <article class="prose prose-slate max-w-none">
    <h1>من نحن</h1>
    <p>{AUTHOR_DESC.ar}</p>
    <h2>لماذا هذا الموقع</h2>
    <p>أكثر حاسبات الزكاة ظهورًا في محركات البحث تديرها جمعيات خيرية. هي نافعة، لكن كلًا منها يعمل بعملة واحدة، وكثيرًا ما يثبّت النصاب مرة في السنة، وينتهي بزر للتبرع عبر تلك الجمعية. أما سؤال الناس فأبسط: كم عليّ اليوم، بعملتي، عن مالي، وما الذي يتغير إن أخذت بمذهب دون آخر؟ هذا الموقع يجيب عن هذا السؤال ويقف عنده.</p>
    <p>يعطي الموقع نصاب اليوم بـ{Object.keys(h.MARKET.fx).length} عملة من سعر الذهب والفضة، ويعرض المبلغين حيث اختلفت المذاهب كالحلي الملبوس والتقاعد المقفل، ويفرد لكل نوع من المال صفحته وحاسبته، ولا يطلب تبرعًا ولا بيانات شخصية.</p>
    <h2>من ينشره</h2>
    <p>تنشر الموقع {AUTHOR_NAME}، وهي شركة مقرها فرنسا تبني حاسبات على الأحكام المنشورة. ليست جهة دينية ولا مجلس فتوى ولا هيئة زكاة ولا جمعية خيرية. لا تجمع مالًا ولا توصي بجهة للدفع ولا شريك لها تحيلك إليه. ولا يوقّع الصفحات عالم بعينه لأن الموقع لا يفتي: هو يطبق أحكامًا نشرتها مجامع وهيئات رسمية ويسمّيها.</p>
    <LegalIdentity lang={lang} />
    <h2>على ماذا يعتمد</h2>
    <p>القرآن الكريم وكتب الحديث في أصل الأحكام؛ وقرارات مجمع الفقه الإسلامي الدولي في الأسهم والتقاعد والعقار والديون؛ وفتاوى دار الإفتاء المصرية ودائرة الإفتاء العام الأردنية؛ ومرسوم الزكاة والعشر الباكستاني؛ ومركز الزكاة في الأقاليم الاتحادية بماليزيا؛ وهيئة الزكاة والضريبة والجمارك السعودية في نسبة السنة الميلادية؛ والمبالغ التي أعلنتها الهيئات المذكورة في كل صفحة لزكاة الفطر والفدية والكفارة في رمضان 1447. وأسعار الذهب والفضة من gold-api.com وأسعار الصرف من البنك المركزي الأوروبي وExchangeRate-API، تُقرأ مرة في اليوم.</p>
    <h2>ما لا يتناوله</h2>
    <p>لا يحسب زكاة الزروع والأنعام والمعادن، وتقف حاسبة المواريث عند الإخوة والأخوات: أبناء الإخوة والأعمام وأبناؤهم وذوو الأرحام يُذكرون ولا يُحسبون. ولا يعرض أي مبلغ لعام 1448 (2027) قبل أن تعلنه الهيئات. وتسرد <a href={route('method', lang)}>صفحة الطريقة</a> كل حكم مع مصدره، وتشرح <a href={route('editorial', lang)}>السياسة التحريرية</a> طريقة التصحيح.</p>
    <h2>التواصل</h2>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> للتصحيحات والمصادر. نجيب عن الأسئلة المتعلقة بحكم أو حساب، لا عن حالتك الشخصية التي ينظر فيها عالم تثق به.</p>
  </article>
</PageLayout>
