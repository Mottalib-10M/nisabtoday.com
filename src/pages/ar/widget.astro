---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'ar';
const code = `<iframe src="${SITE_URL}/embed/zakat-ar/" title="حاسبة الزكاة بنصاب اليوم" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="ضع حاسبة الزكاة بنصاب اليوم في موقعك بسطر واحد" description="يمكن للمساجد والمدارس الإسلامية والمواقع الأهلية تضمين حاسبة الزكاة بالعربية بسطر واحد. يتبع النصاب سعر الذهب والفضة كل يوم، ولا يضع الإطار ملفات تعريف ارتباط." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'الرئيسية', path: route('home', lang) }, { name: 'تضمين الحاسبة', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'تضمين الحاسبة' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">ضع حاسبة الزكاة في موقعك</h1>
    <p class="mt-3 text-lg text-navy-700">سطر واحد من الشيفرة، والنصاب داخل الإطار يتبع سعر الذهب والفضة لليوم.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>الشروط: أبقِ سطر المصدر تحت الإطار ظاهرًا، ولا تغيّر الإطار، ولا تضعه بجوار زر تبرع أو دعوة إلى جمع المال، حتى لا يظن القارئ أن الحاسبة جزء من حملة جمع. لا يضع الإطار ملفات تعريف ارتباط ولا يرسل إلينا شيئًا عن زوارك. للأسئلة: <a href={route('contact', lang)}>صفحة التواصل</a>.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white" dir="ltr"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/zakat-ar/" title="حاسبة الزكاة بنصاب اليوم" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
