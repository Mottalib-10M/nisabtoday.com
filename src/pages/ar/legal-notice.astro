---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { AUTHOR_NAME, CLARITY_ID, CONTACT_EMAIL, GA4_ID, LAST_UPDATED, LEGAL, SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'ar';
---
<PageLayout title={`الإشعار القانوني لموقع ${SITE_NAMES[lang]}: الناشر والاستضافة`} description="من ينشر حاسبة الزكاة والمواريث ومن يستضيفها، وأن الموقع ليس جهة دينية ولا هيئة زكاة ولا جمعية، وحدود المسؤولية، وشروط تضمين الحاسبة في موقع آخر." lang={lang} noindex={true} breadcrumbs={[{ label: 'الإشعار القانوني' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>الإشعار القانوني وشروط الاستخدام</h1>
    <p>بيانات الناشر لموقع {SITE_URL}، المقدمة وفق المادة 6-III-1 من القانون الفرنسي رقم 2004-575 المؤرخ 21 يونيو 2004، لأن الناشر مقيم في فرنسا.</p>
    <h2>الناشر</h2>
    <LegalIdentity lang={lang} />
    <h2>المسؤول عن المحتوى</h2>
    <p>{AUTHOR_NAME}، على العنوان أعلاه، البريد <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
    <h2>الاستضافة</h2>
    <LegalIdentity mode="hosting" lang={lang} />
    <h2>موقع مستقل</h2>
    <p>{SITE_NAMES[lang]} منشور خاص. <strong>ليس جهة دينية ولا مجلس فتوى ولا هيئة زكاة ولا جمعية خيرية</strong>، ولا تديره ولا تموله أي من المجامع والهيئات التي يطبق أحكامها المنشورة. لا يجمع زكاة ولا تبرعًا، ولا يوصي بجهة لدفعها.</p>
    <h2>معلومات عامة لا فتوى</h2>
    <p>تعرض الصفحات أحكام الزكاة وزكاة الفطر والفدية والكفارة والمواريث كما تنشرها المصادر المذكورة في كل صفحة، وتطبقها الحاسبات على الأرقام التي تدخلها. لا شيء هنا فتوى ولا استشارة قانونية أو ضريبية أو مالية. وحيث اختلف العلماء تُعرض النتيجتان، ولحالتك الخاصة اسأل عالمًا تثق به. والتركة التي يحكمها قانون بلد ما تقسمها محاكمه أو موثقوه.</p>
    <h2>المسؤولية</h2>
    <p>نقرأ الأحكام والمبالغ في مصادرها ونختبر محرك الحساب آليًا قبل كل نشر، لكن المبالغ تتغير والخطأ وارد. لا يتحمل الناشر قرارًا اتُّخذ بالاعتماد على الموقع وحده. أبلغنا عن أي خطأ عبر <a href={route('contact', lang)}>صفحة التواصل</a>.</p>
    <h2>الملكية الفكرية</h2>
    <p>النصوص والتصميم والشيفرة ملك للناشر، ويُرحب بالاقتباس القصير مع رابط. أسعار الذهب والفضة من gold-api.com الذي تسمح شروطه بالاستعمال التجاري، وأسعار الصرف من البنك المركزي الأوروبي ومن ExchangeRate-API، وتُستعمل للتحويل وحده ولا تُعاد نشرًا في جدول.</p>
    <h2>التضمين في موقع آخر</h2>
    <p>يجوز تضمين حاسبة الزكاة مجانًا بشرط بقاء سطر المصدر ظاهرًا: <a href={route('widget', lang)}>ضع الحاسبة في موقعك</a>.</p>
    {/* gen-legal-pages:terms */}
    <h2>الخصوصية وملفات تعريف الارتباط</h2>
    {GA4_ID ? (<p>مدخلاتك تبقى في متصفحك. يضع الموقع ملفات تعريف ارتباط لقياس الزيارات بأداة Google Analytics (<code>_ga</code>، <code>_ga_{GA4_ID.replace('G-', '')}</code>، 13 شهراً على الأكثر) دون إعلانات{CLARITY_ID && '، ويقاس استقرار الصفحات بأداة Microsoft Clarity دون ملفات تعريف ارتباط'}. التفاصيل في <a href={route('privacy', lang)}>سياسة الخصوصية</a> وصفحة <a href={route('cookies', lang)}>ملفات تعريف الارتباط</a>.</p>) : (<p>مدخلاتك تبقى في متصفحك، ولا يضع الموقع أي ملف تعريف ارتباط (cookies){CLARITY_ID && '، ويقاس استقرار الصفحات بأداة Microsoft Clarity دون ملفات تعريف ارتباط'}. انظر <a href={route('privacy', lang)}>سياسة الخصوصية</a> وصفحة <a href={route('cookies', lang)}>ملفات تعريف الارتباط</a>.</p>)}
    {/* /gen-legal-pages:terms */}
    <h2>القانون الواجب التطبيق</h2>
    <p>يطبق القانون الفرنسي، وعند تعذر التسوية الودية تختص محاكم {LEGAL.jurisdiction}. آخر تحديث: {LAST_UPDATED}.</p>
  </div>
</PageLayout>
