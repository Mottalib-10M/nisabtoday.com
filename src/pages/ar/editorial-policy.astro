---
import PageLayout from '../../layouts/PageLayout.astro';
import { route } from '../../i18n/routes';
import { AUTHOR_NAME, REVIEW_CYCLE_MONTHS } from '../../data/site-config';
const lang = 'ar';
---
<PageLayout title="السياسة التحريرية لحاسبة الزكاة: المصادر والأرقام والتصحيح" description="كيف تُكتب صفحات حاسبة الزكاة: القرآن والحديث والفتاوى المنشورة وهيئات الزكاة الرسمية وحدها، وكل رقم من ملف بيانات، والقولان معروضان حيث اختلف العلماء." lang={lang} noindex={true} breadcrumbs={[{ label: 'السياسة التحريرية' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>السياسة التحريرية</h1>
    <h2>ما يُعد مصدرًا</h2>
    <p>القرآن الكريم وكتب الحديث؛ وقرارات مجمع الفقه الإسلامي الدولي؛ وفتاوى المجالس الرسمية كدار الإفتاء المصرية ودائرة الإفتاء العام الأردنية؛ والقوانين واللوائح كمرسوم الزكاة والعشر الباكستاني ولائحة جباية الزكاة السعودية؛ وهيئات الزكاة الرسمية كمركز الزكاة في الأقاليم الاتحادية بماليزيا والهيئة الوطنية للزكاة في إندونيسيا والمجلس الإسلامي في سنغافورة. وللمبالغ السنوية إعلان الجهة التي حددتها أو وكالة الأنباء الرسمية التي نقلته. أما مواقع الجمعيات والمدونات والمنتديات فتُقرأ لمعرفة ما يسأل عنه الناس، ولا تكون مصدرًا لحكم أو رقم، ولا نضع رابطًا لأي جمعية.</p>
    <h2>كيف يصل الرقم إلى الصفحة</h2>
    <p>لا يُكتب أي مبلغ في النص باليد. ملفات البيانات تحمل كل وزن ونسبة ومبلغ معلن مع مصدره وتاريخ قراءته، والحاسبات والصفحات تقرأ من هذه الملفات. وتُقرأ أسعار الذهب والفضة وأسعار الصرف مرة في اليوم وتُفحص قبل كتابتها. ويُختبر محرك المواريث على أكثر من خمس عشرة مسألة أجوبتها منشورة، ويتوقف بناء الموقع إن انحرفت إحداها.</p>
    <h2>اختلاف الأقوال</h2>
    <p>حيث اختلفت المذاهب اختلافًا يغيّر المبلغ، كالحلي الملبوس والتقاعد المقفل وأسهم الاستثمار والديون والمسألة المشتركة، تعرض الصفحة كل قول مع مصدره وتتيح الحاسبة التبديل بينها. لا يختار الموقع عنك ولا يقدم قولًا على أنه الوحيد. ولحالتك الخاصة اسأل عالمًا تثق به.</p>
    <h2>الاستقلال</h2>
    <p>لا تتلقى {AUTHOR_NAME} شيئًا من الجمعيات ولا من جامعي الزكاة ولا من البنوك أو شركات التمويل الإسلامي، ولا تضع روابط إليها. لا زر تبرع ولا إعلانات اليوم، وإن أضيفت إعلانات فستُميَّز ولن تأتي أبدًا من جهة تجمع الزكاة أو التبرعات.</p>
    <h2>المراجعة والتصحيح</h2>
    <p>يُراجع الموقع مرة كل {REVIEW_CYCLE_MONTHS} شهرًا على الأقل، وفي كل الأحوال قبل كل رمضان حين تعلن الهيئات مبالغ زكاة الفطر والفدية والكفارة للعام الجديد. ويُفحص كل خطأ يُبلغ عنه مقابل مصدره، ويتغير تاريخ الصفحة بعد تصحيحه. راسلنا عبر <a href={route('contact', lang)}>صفحة التواصل</a>، وطريقة الحساب مشروحة في <a href={route('method', lang)}>صفحة الطريقة</a>.</p>
  </div>
</PageLayout>
