---
/** Embeddable page (iframe): the zakat calculator alone, English or Arabic (?lang is not read: two files). noindex, outside the sitemap. */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zakat calculator with today’s nisab (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind="zakat" idPrefix="embed" lang="en" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · gold and silver prices of the day · a calculation, not a fatwa</p>
  </body>
</html>
