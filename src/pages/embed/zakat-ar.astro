---
/** Embeddable page (iframe): the zakat calculator in Arabic. noindex, outside the sitemap. */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>حاسبة الزكاة بنصاب اليوم (للتضمين)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/ar/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <main><Tool kind="zakat" idPrefix="embed" lang="ar" /></main>
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/ar/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.ar}</a> · أسعار الذهب والفضة لليوم · حساب لا فتوى</p>
  </body>
</html>
